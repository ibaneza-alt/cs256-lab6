# Step 1) parse_course_record
def parse_course_record(course_string):
    """This function will orgnanize messy course strings into a structured dictionary that holds key values of course code, name, credits, and status"""

    # This new variable will separate the 4 parts retrieved from the courses string with a comma
    course_info = course_string.split(",")

    # Will retrieve the code section of the course and remove any white spaces while also keeping capitalization consistent 
    code = course_info[0].strip().upper()
    # Get name of course and remove whitespace  
    name = course_info[1].strip()
    # Get number of credits from course and remove whitespace
    credits = int(course_info[2].strip())
    # Get status of course and remove whitespace and use uppercase
    status = course_info[3].strip().upper()

    # Returns a dictionary with key information of the course
    return {
        "code": code,
        "name": name,
        "credits": credits,
        "status": status
    }
# Step 2) get_gen_ed_category
def get_gen_ed_category(course_code, gen_ed_mapping):
    """This function will determine which general education bin a course will be sent to"""
    # First for loop will check whether each gen ed category is actually in the gen ed mapping dictionary
    for gen_ed_category in gen_ed_mapping:
        # This nestled for loop will then check that each approved course code is in the gen ed mapping dictioanry
        for code in gen_ed_mapping[gen_ed_category]:
            # And if the course code was found within the dictionary then the gen ed category will be returned
            if course_code.upper() == code.upper():
                return gen_ed_category
    # But if the for loops complete, and the course code was not found then "uncategorized" will be returned         
    return "Uncategorized"

# Step 3) audit_credits
def audit_credits(student_bins):
    """This function will calculate the total credits that a student has in each category"""

    # Created a new variable dictionary that sets each gen ed category to a value of 0
    total_credits = {
        "Creativity and Innovation": 0,
        "Communication and Expression": 0,
        "Equity, Diversity, and Inclusion": 0,
        "Inquiry and Analysis": 0,
        "Numerical Literacy": 0,
        "Purposeful Learning": 0,
        "Uncategorized": 0
    }
    # This for loop goes through each Gen Ed category in the student bins dictionary
    for category in student_bins:
        # Nestled for loop to go through each course tuple in category 
        for course in student_bins[category]:
            # Get the value of credits from position 1 of course
            credits = course[1]
            # Add up the category credits
            total_credits[category] += credits
    return total_credits

