# Step 1) Format a single course into a structured dictionary

def parse_course_record(course_string):
    """This function will orgnanize messy course strings into a structured dictionary that holds key values of course code, name, credits, and status"""

    # This new variable will separate the 4 parts retrieved from the courses string with a comma
    course_info = course_string.split(",")

    # Will retrieve the code section of the course and remove any white spaces while also keeping capitalization consistent 
    code = course_info[0].strip().upper()
    # Get name of course and remove whitespace  
    name = course_info[1].strip()
    # Get number of credits from course and remove whitespace
    credits = int(course_info[2].strip())
    # Get status of course and remove whitespace and use uppercase
    status = course_info[3].strip().upper()

    # Returns a dictionary with key information of the course
    return {
        "code": code,
        "name": name,
        "credits": credits,
        "status": status
    }

